#!/usr/bin/env bash
set -euo pipefail

mode="${1:-menu}"

readonly PANEL_Y_MARGIN="${AUDIO_DEVICE_PANEL_Y_MARGIN:-36}"
readonly PANEL_WIDTH="${AUDIO_DEVICE_PANEL_WIDTH:-48}"
readonly DEVICE_LABEL_LIMIT="${AUDIO_DEVICE_LABEL_LIMIT:-34}"

notify() {
	if command -v notify-send >/dev/null 2>&1; then
		notify-send "Audio device" "$1"
	fi
}

open_fallback() {
	if command -v pavucontrol >/dev/null 2>&1; then
		pavucontrol >/dev/null 2>&1 &
		exit 0
	fi

	notify "Install fuzzel, wofi, rofi, bemenu, tofi, or pavucontrol."
	exit 1
}

pick() {
	local prompt="$1"
	local choices="$2"

	if command -v fuzzel >/dev/null 2>&1; then
		printf '%s\n' "$choices" | fuzzel \
			--dmenu \
			--namespace=waybar-audio-device \
			--layer=overlay \
			--anchor=top-right \
			--x-margin=8 \
			--y-margin="$PANEL_Y_MARGIN" \
			--width="$PANEL_WIDTH" \
			--lines=12 \
			--minimal-lines \
			--hide-prompt \
			--no-sort \
			--only-match \
			--no-run-if-empty \
			--with-nth=1 \
			--match-nth='{1} {4}' \
			--font='BlexMono Nerd Font:size=13' \
			--background-color=121418e0 \
			--text-color=e6e8ecff \
			--prompt-color=f4f6f8ff \
			--input-color=e6e8ecff \
			--match-color=f9a8d4ff \
			--selection-color=8bd3ffff \
			--selection-text-color=111418ff \
			--selection-match-color=111418ff \
			--border-color=ffffff1a \
			--border-width=1 \
			--border-radius=8 \
			--selection-radius=6
	elif command -v wofi >/dev/null 2>&1; then
		printf '%s\n' "$choices" | wofi --dmenu --prompt "$prompt"
	elif command -v rofi >/dev/null 2>&1; then
		printf '%s\n' "$choices" | rofi -dmenu -p "$prompt"
	elif command -v bemenu >/dev/null 2>&1; then
		printf '%s\n' "$choices" | bemenu -p "$prompt"
	elif command -v tofi >/dev/null 2>&1; then
		printf '%s\n' "$choices" | tofi --prompt-text "$prompt: "
	else
		open_fallback
	fi
}

device_type() {
	case "$1" in
	output | sink)
		printf 'sink'
		;;
	input | source)
		printf 'source'
		;;
	*)
		notify "Unknown mode: $1"
		exit 2
		;;
	esac
}

list_devices() {
	local kind="$1"
	local on_missing="${2:-fail}"
	local list_name="${kind}s"
	local default_device
	local label
	local icon

	if ! default_device="$(pactl "get-default-$kind" 2>/dev/null)"; then
		[[ "$on_missing" == "skip" ]] && return 0
		notify "Could not connect to PulseAudio/PipeWire."
		exit 1
	fi

	case "$kind" in
	sink)
		label="Output"
		icon="󰕾"
		;;
	source)
		label="Input"
		icon="󰍬"
		;;
	esac

	pactl list "$list_name" | awk \
		-v default_device="$default_device" \
		-v kind="$kind" \
		-v label="$label" \
		-v icon="$icon" \
		-v limit="$DEVICE_LABEL_LIMIT" '
    BEGIN { RS = ""; FS = "\n" }
    function shorten(value) {
      if (length(value) <= limit) {
        return value
      }

      return substr(value, 1, limit - 3) "..."
    }

    {
      name = ""
      description = ""

      for (i = 1; i <= NF; i++) {
        line = $i
        sub(/^[[:space:]]+/, "", line)

        if (line ~ /^Name: /) {
          name = line
          sub(/^Name: /, "", name)
        }

        if (line ~ /^Description: /) {
          description = line
          sub(/^Description: /, "", description)
        }
      }

      if (name == "") {
        next
      }

      if (kind == "source" && name ~ /\.monitor$/) {
        next
      }

      if (description == "") {
        description = name
      }

      marker = name == default_device ? "●" : "○"
      printf "%s  %s  %-6s %s\t%s\t%s\t%s\n", marker, icon, label, shorten(description), kind, name, description
    }
  '
}

move_streams() {
	local kind="$1"
	local device="$2"
	local streams stream

	if [[ "$kind" == "sink" ]]; then
		streams="$(pactl list short sink-inputs 2>/dev/null | cut -f1 || true)"
		while IFS= read -r stream; do
			[[ -n "$stream" ]] && pactl move-sink-input "$stream" "$device" >/dev/null 2>&1 || true
		done <<<"$streams"
	else
		streams="$(pactl list short source-outputs 2>/dev/null | cut -f1 || true)"
		while IFS= read -r stream; do
			[[ -n "$stream" ]] && pactl move-source-output "$stream" "$device" >/dev/null 2>&1 || true
		done <<<"$streams"
	fi
}

choose_device() {
	local kind="$1"
	local label="$2"
	local choices selected

	choices="$(list_devices "$kind")"
	if [[ -z "$choices" ]]; then
		notify "No $label devices found."
		exit 1
	fi

	selected="$(pick "$label" "$choices" || true)"
	[[ -z "$selected" || "$selected" != *$'\t'* ]] && exit 0

	activate_device "$selected"
}

activate_device() {
	local selected="$1"
	local label kind device description

	IFS=$'\t' read -r _ kind device description <<<"$selected"
	[[ -z "$kind" || -z "$device" ]] && exit 0

	case "$kind" in
	sink)
		label="output"
		;;
	source)
		label="input"
		;;
	*)
		notify "Unknown audio device type: $kind"
		exit 2
		;;
	esac

	pactl "set-default-$kind" "$device"
	move_streams "$kind" "$device"
	notify "Default $label: $description"
}

choose_menu() {
	local choices selected

	choices="$({
		list_devices "sink" "skip"
		list_devices "source" "skip"
	} || true)"
	if [[ -z "$choices" ]]; then
		notify "No audio devices found."
		exit 1
	fi

	selected="$(pick "Audio" "$choices" || true)"
	[[ -z "$selected" || "$selected" != *$'\t'* ]] && exit 0

	activate_device "$selected"
}

if ! command -v pactl >/dev/null 2>&1; then
	notify "pactl is required for device selection."
	open_fallback
fi

case "$mode" in
menu)
	choose_menu
	;;
output | sink)
	choose_device "sink" "output"
	;;
input | source)
	choose_device "source" "input"
	;;
*)
	choose_device "$(device_type "$mode")" "$mode"
	;;
esac
